APP_ENV=development
# Replace both local placeholders with different random secrets before Docker Compose.
POSTGRES_PASSWORD=change-this-before-compose
REDIS_PASSWORD=change-this-before-compose
REDIS_URL=
PUBLIC_DOMAIN=your-domain.example
APP_NAME=AlgoForge
DATABASE_URL=sqlite:///./algoforge.db
# For production, use PostgreSQL, for example:
# DATABASE_URL=postgresql+psycopg://algoforge:change-me@db:5432/algoforge

# Judge0 runs separately; the shared CE endpoint is only a convenient development default.
# Production must use your own secured HTTPS Judge0 service (see docs/JUDGE0_DEPLOYMENT.md).
JUDGE0_URL=https://ce.judge0.com
JUDGE0_TOKEN=
JUDGE0_LANGUAGE_C=103
JUDGE0_LANGUAGE_CPP=105
JUDGE0_LANGUAGE_JAVA=91
JUDGE0_LANGUAGE_PYTHON=109
JUDGE0_TIMEOUT_SECONDS=25

COOKIE_SECURE=false
SESSION_TTL_DAYS=7
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
PUBLIC_BASE_URL=http://localhost:8000
